<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Header & Admin Button -->
    <TextView
        android:id="@+id/txtCatalogHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:text="Select Items"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnAdminAccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="Admin" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/btnAdminAccess"
        android:layout_marginTop="8dp"
        android:background="#CCCCCC" />

    <!-- Slot List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCatalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomCartBar"
        android:layout_below="@id/headerDivider"
        android:layout_marginVertical="8dp" />

    <!-- Bottom Cart Summary Bar -->
    <LinearLayout
        android:id="@+id/bottomCartBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txtCartTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: $0.00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheckout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Proceed to Checkout" />
    </LinearLayout>

</RelativeLayout>